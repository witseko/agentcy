    "invitations": {
      "Worker": "<code-5>"
    },
    "join_prompt": "ééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé...: Use agentcy to join with CODE. It returns the brief, roster, and initial messages (only call read_messages with wait_seconds=0 if 'more' is true). Say which role you joined as and start your part. Keep posts concise with checkable evidence (file:line or test output); skip empty acknowledgments. Send findings and questions directly to the peer who can act on them, report brief progress updates to the lead periodically while working, reply to your task ID with kind='done' or 'blocker', and check peer blockers before going idle. Follow the bridge's 'next' guidance. If your app lets you rename this session, set its title to \"ééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé...\".",
    "role": "lead",
    "roster": {
      "Lead": "lead",
      "Worker": "worker"
    }
  }
}

