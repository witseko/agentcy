== 2. lead joins
-> {"action": "join", "code": "<code-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-1>",
    "participant": "Lead",
    "role": "co-lead",
    "roster": {
      "Human": "human",
      "Lead": "co-lead",
      "Partner": "co-lead",
      "Worker": "worker"
    },
    "brief": "Review retries\nDetails follow",
    "token": "<token-1>",
    "messages": [],
    "cursor": 0,
    "more": false
  }
}

== 3. lead status reports the human
-> {"action": "status", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "open": true,
    "members": {
      "Lead": {
        "role": "co-lead",
        "state": "joined",
        "idle_seconds": "<idle-seconds>"
      },
      "Worker": {
        "role": "worker",
        "state": "invited"
      },
      "Partner": {
        "role": "co-lead",
        "state": "invited"
      },
      "Human": {
        "role": "human",
        "state": "human"
      }
    },
    "participant": "Lead",
    "open_invite": true
  }
}

== 4. the human posts
-> {"action": "operator_post", "body": "Go ahead.", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "submission_id": "n1", "version": 1}
<- {
  "result": {
    "message_id": 1
  }
}

== 5. the human retries the post
-> {"action": "operator_post", "body": "Go ahead.", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "submission_id": "n1", "version": 1}
<- {
  "result": {
    "message_id": 1
  }
}

== 6. the human reuses the ID with another body
-> {"action": "operator_post", "body": "Changed", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "submission_id": "n1", "version": 1}
<- {
  "error": "Submission ID already used for a different message"
}

== 7. the human addresses an unknown member
-> {"action": "operator_post", "body": "Hi", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "submission_id": "n2", "to": "Ghost", "version": 1}
<- {
  "error": "Unknown recipient 'Ghost' in this conversation. Active members: Human, Lead, Partner, Worker"
}

== 8. show returns status, brief and transcript
-> {"action": "operator_show", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "version": 1}
<- {
  "result": {
    "conversation": "<room-1>",
    "title": "Review retries",
    "brief": "Review retries\nDetails follow",
    "created": "<now>",
    "archived": false,
    "status": {
      "open": true,
      "members": {
        "Lead": {
          "role": "co-lead",
          "state": "joined",
          "idle_seconds": "<idle-seconds>"
        },
        "Worker": {
          "role": "worker",
          "state": "invited"
        },
        "Partner": {
          "role": "co-lead",
          "state": "invited"
        },
        "Human": {
          "role": "human",
          "state": "human"
        }
      },
      "open_invite": true
    },
    "messages": [
      {
        "id": 1,
        "label": "Human",
        "body": "Go ahead.",
        "created": "<now>"
      }
    ],
    "more": false,
    "cursor": 1,
    "total_messages": 1
  }
}

== 9. lead reads the human's message with role human
-> {"action": "read", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "messages": [
      {
        "id": 1,
        "label": "Human",
        "body": "Go ahead.",
        "role": "human"
      }
    ],
    "more": false,
    "cursor": 1,
    "wake": true,
    "brief": "Review retries\nDetails follow",
    "role": "co-lead",
    "roster": {
      "Human": "human",
      "Lead": "co-lead",
      "Partner": "co-lead",
      "Worker": "worker"
    }
  }
}

== 10. list shows the conversation
