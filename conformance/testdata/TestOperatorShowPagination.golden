== 111. after and tail together
-> {"action": "operator_show", "after": 5, "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "tail": true, "version": 1}
<- {
  "error": "Invalid bridge arguments"
}

== 112. after and before together
-> {"action": "operator_show", "after": 5, "before": 10, "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "version": 1}
<- {
  "error": "Invalid bridge arguments"
}

== 113. before and tail together
-> {"action": "operator_show", "before": 10, "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "tail": true, "version": 1}
<- {
  "error": "Invalid bridge arguments"
}

