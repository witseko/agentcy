<- {
  "result": {
    "conversation": "<room-3>",
    "token": "<token-3>",
    "invitations": {
      "W": "<code-4>"
    },
    "join_prompt": "B: Use agentcy to join with CODE. It returns the brief, roster, and initial messages (only call read_messages with wait_seconds=0 if 'more' is true). Say which role you joined as and start your part. Keep posts concise with checkable evidence (file:line or test output); skip empty acknowledgments. Send findings and questions directly to the peer who can act on them, report brief progress updates to the lead periodically while working, reply to your task ID with kind='done' or 'blocker', and check peer blockers before going idle. Follow the bridge's 'next' guidance. If your app lets you rename this session, set its title to \"B\".",
    "role": "lead",
    "roster": {
      "Lead": "lead",
      "W": "worker"
    },
    "open_invite": {
      "code": "<code-5>",
      "join_prompt": "B - worker: Use agentcy to join with CODE (pass your preferred name if you want one). It returns the brief, roster, and initial messages (only call read_messages with wait_seconds=0 if 'more' is true). Say which role you joined as and start your part. Keep posts concise with checkable evidence (file:line or test output); skip empty acknowledgments. Send findings and questions directly to the peer who can act on them, report brief progress updates to the lead periodically while working, reply to your task ID with kind='done' or 'blocker', and check peer blockers before going idle. Follow the bridge's 'next' guidance. If your app lets you rename this session, set its title to \"B - worker\"."
    }
  }
}

== 29. create with a float token budget
-> {"action": "create", "brief": "B", "initiator": "Lead", "initiator_token_budget": 10.5, "invitees": ["W"], "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 30. create with a string token budget
-> {"action": "create", "brief": "B", "initiator": "Lead", "initiator_token_budget": "10", "invitees": ["W"], "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 31. read with a boolean cursor
-> {"action": "read", "after": true, "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "messages": [],
    "more": false,
    "cursor": 1,
    "wake": false
  }
}

== 32. invite with a string reinvite
-> {"action": "invite", "name": "X", "reinvite": "true", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "error": "Unknown participant in this conversation"
}

== 33. open_invite with a null enabled
-> {"action": "open_invite", "enabled": null, "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 34. set_role with a null role
-> {"action": "set_role", "name": "Worker", "role": null, "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 35. list_closed with a string archived
-> {"action": "list_closed", "archived": "yes", "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversations": []
  }
}

== 36. read_closed with a numeric cursor string
-> {"action": "read_closed", "after": "5", "conversation": "<room-4>", "workspace": "<workspace-1>"}
<- {
  "error": "Unknown closed conversation in this workspace"
}

