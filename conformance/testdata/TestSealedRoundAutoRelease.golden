== 13. Second reads: proposals stay hidden
-> {"action": "read", "token": "<token-3>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "messages": [
      {
        "id": 1,
        "label": "Lead",
        "body": "Work alone"
      }
    ],
    "more": false,
    "cursor": 1,
    "wake": true,
    "round": "sealed",
    "round_deadline": "<now+1m>",
    "brief": "Propose a test independently",
    "role": "worker",
    "roster": {
      "First": "worker",
      "Late": "worker",
      "Lead": "lead",
      "Second": "worker"
    }
  }
}

== 14. Second submits, which releases the round
-> {"action": "post", "body": "Test the retry", "kind": "proposal", "submission_id": "s1", "token": "<token-3>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 3
  }
}

== 15. First's retry after release returns the message ID
-> {"action": "post", "body": "Test the timeout", "kind": "proposal", "submission_id": "p1", "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 2
  }
}

== 16. First's new ID with the released body returns the message ID
-> {"action": "post", "body": "Test the timeout", "kind": "proposal", "submission_id": "p3", "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 2
  }
}

== 17. a new proposal after release is not accepted
-> {"action": "post", "body": "Late idea", "kind": "proposal", "submission_id": "p4", "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "round": "critique",
    "accepted": false
  }
}

== 18. Late joins after release
-> {"action": "join", "code": "<code-3>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-1>",
    "participant": "Late",
    "role": "worker",
    "roster": {
      "First": "worker",
      "Late": "worker",
      "Lead": "lead",
      "Second": "worker"
    },
    "brief": "Propose a test independently",
    "token": "<token-4>",
    "messages": [
      {
        "id": 1,
        "label": "Lead",
        "body": "Work alone"
      },
      {
        "id": 2,
        "label": "First",
        "body": "Test the timeout",
        "kind": "proposal"
      },
      {
        "id": 3,
        "label": "Second",
        "body": "Test the retry",
        "kind": "proposal"
      },
      {
        "id": 4,
        "label": "Second",
        "body": "Proposals released for critique. Missing proposals from: Late.",
        "kind": "event"
      }
    ],
    "cursor": 4,
    "more": false,
    "round": "critique"
  }
}

== 19. Late's proposal in the critique round
-> {"action": "post", "body": "Too late", "kind": "proposal", "submission_id": "submission-11", "token": "<token-4>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "round": "critique",
    "accepted": false
  }
}

