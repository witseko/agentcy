      "First": {
        "role": "worker",
        "state": "joined",
        "idle_seconds": "<idle-seconds>"
      },
      "Second": {
        "role": "worker",
        "state": "joined",
        "idle_seconds": "<idle-seconds>"
      },
      "Late": {
        "role": "worker",
        "state": "invited"
      }
    },
    "participant": "First",
    "round": "sealed",
    "round_deadline": "<now+1m>",
    "proposal_submitted": true
  }
}

