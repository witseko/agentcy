== 16. status after balancing
-> {"action": "status", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "open": true,
    "members": {
      "Lead": {
        "role": "lead",
        "state": "replied",
        "idle_seconds": "<idle-seconds>",
        "messages": 8
      },
      "Alpha": {
        "role": "worker",
        "state": "retired",
        "messages": 3
      },
      "Bravo": {
        "role": "worker",
        "state": "joined",
        "idle_seconds": "<idle-seconds>",
        "open_tasks": [
          {
            "id": 2,
            "due": "<now+30m>"
