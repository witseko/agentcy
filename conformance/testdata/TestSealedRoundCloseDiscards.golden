== 4. First submits a secret proposal
-> {"action": "post", "body": "Secret zebra plan", "kind": "proposal", "submission_id": "submission-1", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "proposal_id": "<proposal-1>"
  }
}

== 5. search does not find a held proposal
-> {"action": "operator_search", "directory": "<checkout>", "key": "<operator-key>", "query": "zebra", "version": 1}
<- {
  "result": {
    "hits": []
  }
}

== 6. show hides the held proposal
-> {"action": "operator_show", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "version": 1}
<- {
  "result": {
    "conversation": "<room-1>",
    "title": "Propose privately",
    "brief": "Propose privately",
    "created": "<now>",
    "archived": false,
    "status": {
      "open": true,
      "members": {
        "Lead": {
          "role": "lead",
          "state": "invited"
        },
        "First": {
          "role": "worker",
          "state": "joined",
          "idle_seconds": "<idle-seconds>"
        },
        "Second": {
          "role": "worker",
          "state": "joined"
        },
        "Human": {
          "role": "human",
          "state": "human"
        }
      },
      "round": "sealed",
      "round_deadline": "<now+15m>"
    },
    "messages": [],
    "more": false,
    "cursor": 0,
    "total_messages": 0
  }
}

== 7. the human posts during the round
-> {"action": "operator_post", "body": "Take your time", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "submission_id": "h", "version": 1}
<- {
  "result": {
    "message_id": 1
  }
}

== 8. the human closes with a summary
-> {"action": "operator_close", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "summary": "Stopped early", "version": 1}
<- {
  "result": {
    "closed": true
  }
}

== 9. the closed record has no proposal
-> {"action": "read_closed", "conversation": "<room-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-1>",
    "closed": true,
    "archived": false,
    "created": "<now>",
    "brief": "Propose privately",
    "roster": {
      "First": "worker",
      "Human": "human",
      "Lead": "lead",
      "Second": "worker"
    },
    "messages": [
      {
        "id": 1,
        "label": "Human",
        "body": "Take your time",
        "created": "<now>"
      },
      {
        "id": 2,
        "label": "Human",
        "body": "Stopped early",
        "created": "<now>"
      }
    ],
    "more": false,
    "cursor": 2,
    "total_messages": 2
  }
}

== 10. search still finds nothing
-> {"action": "operator_search", "directory": "<checkout>", "key": "<operator-key>", "query": "zebra", "version": 1}
