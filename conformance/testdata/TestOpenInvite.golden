== 9. the reserved name is refused
-> {"action": "join", "code": "<code-1>", "name": "Human", "workspace": "<workspace-1>"}
<- {
  "error": "The name Human is reserved for the user. Use a different name"
}

== 10. another workspace is refused
-> {"action": "join", "code": "<code-1>", "workspace": "<workspace-2>"}
<- {
  "error": "Join code does not match this workspace. Set both clients to the same --workspace and reconnect."
}

