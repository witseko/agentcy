== 1. lead creates an open room
-> {"action": "create", "brief": "Investigate flaky build", "initiator": "Lead", "invitees": [], "open_invite": true, "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-1>",
    "token": "<token-1>",
    "invitations": {},
    "join_prompt": "Investigate flaky build: Use agentcy to join with CODE. It returns the brief, roster, and initial messages (only call read_messages with wait_seconds=0 if 'more' is true). Say which role you joined as and start your part. Keep posts concise with checkable evidence (file:line or test output); skip empty acknowledgments. Send findings and questions directly to the peer who can act on them, report brief progress updates to the lead periodically while working, reply to your task ID with kind='done' or 'blocker', and check peer blockers before going idle. Follow the bridge's 'next' guidance. If your app lets you rename this session, set its title to \"Investigate flaky build\".",
    "role": "lead",
    "roster": {
      "Lead": "lead"
    },
    "open_invite": {
      "code": "<code-1>",
      "join_prompt": "Investigate flaky build - worker: Use agentcy to join with CODE (pass your preferred name if you want one). It returns the brief, roster, and initial messages (only call read_messages with wait_seconds=0 if 'more' is true). Say which role you joined as and start your part. Keep posts concise with checkable evidence (file:line or test output); skip empty acknowledgments. Send findings and questions directly to the peer who can act on them, report brief progress updates to the lead periodically while working, reply to your task ID with kind='done' or 'blocker', and check peer blockers before going idle. Follow the bridge's 'next' guidance. If your app lets you rename this session, set its title to \"Investigate flaky build - worker\"."
    }
  }
}

== 2. Alice joins
-> {"action": "join", "code": "<code-1>", "name": "Alice", "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-1>",
    "participant": "Alice",
    "role": "worker",
    "roster": {
      "Alice": "worker",
      "Lead": "lead"
    },
    "brief": "Investigate flaky build",
    "token": "<token-2>",
    "messages": [
      {
        "id": 1,
        "label": "Alice",
        "body": "Alice joined via the open invite.",
        "kind": "event"
      }
    ],
    "cursor": 1,
    "more": false
  }
}

