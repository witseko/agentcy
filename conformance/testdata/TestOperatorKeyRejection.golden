-> {"action": "operator_set_member_budget", "conversation": "<room-1>", "directory": "<checkout>", "key": "<200 characters starting \"kkkkkkkkkkkk\">", "name": "W", "token_budget": 10, "version": 1}
<- {
  "error": "Operator key rejected"
}

== 103. operator_set_member_budget with a wrong key
-> {"action": "operator_set_member_budget", "conversation": "<room-1>", "directory": "<checkout>", "key": "", "name": "W", "token_budget": 10, "version": 1}
<- {
  "error": "Operator key rejected"
}

== 104. operator_set_member_budget with a wrong key
-> {"action": "operator_set_member_budget", "conversation": "<room-1>", "directory": "<checkout>", "key": "schlüssel", "name": "W", "token_budget": 10, "version": 1}
<- {
  "error": "Operator key rejected"
}

== 105. list shows one conversation with one joined slot
-> {"action": "operator_list", "directory": "<checkout>", "key": "<operator-key>", "version": 1}
<- {
  "result": {
    "conversations": [
      {
        "conversation": "<room-1>",
        "title": "Keyed",
        "open": true,
        "created": "<now>",
        "members": 2,
        "joined": 1
      }
    ]
  }
}

