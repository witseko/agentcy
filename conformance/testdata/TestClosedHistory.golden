}

== 36. a malformed conversation ID
-> {"action": "read_closed", "conversation": "../etc", "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 37. an uppercase conversation ID
-> {"action": "read_closed", "conversation": "0123456789ABCDEF01234567", "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 38. a token is not accepted
-> {"action": "read_closed", "conversation": "<room-2>", "token": "x", "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 39. list_closed refuses unknown fields
-> {"action": "list_closed", "after": 0, "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

