== 30. read_closed after the cursor
-> {"action": "read_closed", "after": 16, "conversation": "<room-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-2>",
    "closed": true,
    "archived": false,
    "created": "<now>",
    "messages": [
      {
        "id": 17,
        "label": "Lead",
        "body": "Entry 17",
        "created": "<now>"
      },
      {
        "id": 18,
        "label": "Lead",
        "body": "All checks passed.",
        "created": "<now>"
      }
    ],
    "more": false,
    "cursor": 18,
    "total_messages": 18
  }
}

== 31. the human archives the first conversation
-> {"action": "operator_archive", "archived": true, "conversation": "<room-2>", "directory": "<checkout>", "key": "<operator-key>", "version": 1}
<- {
  "result": {
    "archived": true
  }
}

