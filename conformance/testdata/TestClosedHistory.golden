    "role": "lead",
    "roster": {
      "Lead": "lead",
      "Worker": "worker"
    }
  }
}

== 28. list_closed shows both closed conversations, newest first
-> {"action": "list_closed", "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversations": [
      {
        "conversation": "<room-3>",
        "title": "Second",
        "created": "<now>",
        "archived": false,
        "messages": 0
      },
      {
        "conversation": "<room-2>",
        "title": "History brief",
        "created": "<now>",
        "archived": false,
        "messages": 18
      }
    ]
  }
}

