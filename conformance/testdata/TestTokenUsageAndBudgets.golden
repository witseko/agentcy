== 20. lead retires the worker
-> {"action": "retire", "name": "Worker", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "participant": "Worker",
    "retired": true
  }
}

== 21. a retired worker cannot report usage
-> {"action": "report_usage", "input_tokens": 1, "output_tokens": 1, "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "error": "You have been retired from this conversation"
}

== 22. the human closes
-> {"action": "operator_close", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "summary": "Done", "version": 1}
<- {
  "result": {
    "closed": true
  }
}

== 23. report usage after close
-> {"action": "report_usage", "input_tokens": 1, "output_tokens": 1, "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "error": "Conversation is closed"
}

== 24. set budget after close
-> {"action": "operator_set_member_budget", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "name": "Lead", "token_budget": 100000, "version": 1}
<- {
  "error": "Conversation is closed"
}

