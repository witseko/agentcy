== 7. the human cannot reissue a joined slot
-> {"action": "operator_invite", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "name": "Worker", "version": 1}
<- {
  "error": "Invitation slot already taken: Worker. Pass reinvite to replace its chat"
}

