  }
}

== 9. the old worker chat lost access
-> {"action": "status", "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "error": "Invalid participant token"
}

== 10. the human cannot reinvite itself
-> {"action": "operator_invite", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "name": "Human", "reinvite": true, "version": 1}
<- {
  "error": "The name Human is reserved for the user. Use a different name"
}

== 11. the human retires the unjoined spare slot
-> {"action": "operator_retire", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "name": "Spare", "version": 1}
<- {
  "result": {
    "participant": "Spare",
    "retired": true
  }
}

== 12. a plain invite refuses the retired slot
-> {"action": "operator_invite", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "name": "Spare", "version": 1}
<- {
  "error": "Participant is retired: Spare. Pass reinvite to bring them back"
}

