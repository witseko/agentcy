== 10. search treats operators as words
-> {"action": "operator_search", "directory": "<checkout>", "key": "<operator-key>", "query": "backoff OR timeout", "version": 1}
<- {
  "result": {
    "hits": []
  }
}

== 11. search with unicode words
-> {"action": "operator_search", "directory": "<checkout>", "key": "<operator-key>", "query": "über", "version": 1}
<- {
  "result": {
    "hits": []
  }
}

== 12. search needs a word
-> {"action": "operator_search", "directory": "<checkout>", "key": "<operator-key>", "query": "!!! ???", "version": 1}
<- {
  "error": "Search needs at least one letter or digit"
}

== 13. an empty query fails validation
-> {"action": "operator_search", "directory": "<checkout>", "key": "<operator-key>", "query": "", "version": 1}
<- {
  "error": "Invalid bridge arguments"
}

== 14. a 201-character query fails validation
-> {"action": "operator_search", "directory": "<checkout>", "key": "<operator-key>", "query": "<201 characters starting \"qqqqqqqqqqqq\">", "version": 1}
<- {
  "error": "Invalid bridge arguments"
}

== 15. only the first eight words count
-> {"action": "operator_search", "directory": "<checkout>", "key": "<operator-key>", "query": "backoff ceiling one two three four five six seven", "version": 1}
<- {
  "result": {
    "hits": []
  }
}

== 16. the human closes the first
-> {"action": "operator_close", "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "version": 1}
<- {
  "result": {
    "closed": true
  }
}

== 17. the human archives the first
-> {"action": "operator_archive", "archived": true, "conversation": "<room-1>", "directory": "<checkout>", "key": "<operator-key>", "version": 1}
<- {
  "result": {
    "archived": true
  }
}

