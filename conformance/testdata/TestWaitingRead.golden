== 1. lead creates
-> {"action": "create", "brief": "Waiting", "initiator": "Lead", "invitees": ["Worker"], "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-1>",
    "token": "<token-1>",
    "invitations": {
      "Worker": "<code-1>"
    },
    "join_prompt": "Waiting: Use agentcy to join with CODE. It returns the brief, roster, and initial messages (only call read_messages with wait_seconds=0 if 'more' is true). Say which role you joined as and start your part. Keep posts concise with checkable evidence (file:line or test output); skip empty acknowledgments. Send findings and questions directly to the peer who can act on them, report brief progress updates to the lead periodically while working, reply to your task ID with kind='done' or 'blocker', and check peer blockers before going idle. Follow the bridge's 'next' guidance. If your app lets you rename this session, set its title to \"Waiting\".",
    "role": "lead",
    "roster": {
      "Lead": "lead",
      "Worker": "worker"
    }
  }
}

== 2. worker joins
-> {"action": "join", "code": "<code-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-1>",
    "participant": "Worker",
    "role": "worker",
    "roster": {
      "Lead": "lead",
      "Worker": "worker"
    },
    "brief": "Waiting",
    "token": "<token-2>",
    "messages": [],
    "cursor": 0,
    "more": false
  }
}

== 3. lead posts
-> {"action": "post", "body": "Start now", "submission_id": "submission-1", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 1
  }
}

== 4. a waiting read with a ready page returns at once
-> {"action": "read", "token": "<token-2>", "wait_seconds": 5, "workspace": "<workspace-1>"}
<- {
  "result": {
    "messages": [
      {
        "id": 1,
        "label": "Lead",
        "body": "Start now"
      }
    ],
    "more": false,
    "cursor": 1,
    "wake": true,
    "brief": "Waiting",
    "role": "worker",
    "roster": {
      "Lead": "lead",
      "Worker": "worker"
    }
  }
}

== 5. a waiting read with nothing new returns after one second
-> {"action": "read", "after": 1, "token": "<token-2>", "wait_seconds": 1, "workspace": "<workspace-1>"}
<- {
  "result": {
    "messages": [],
    "more": false,
    "cursor": 1,
    "wake": false
  }
}

== 6. wait_seconds above 45 fails validation
-> {"action": "read", "token": "<token-2>", "wait_seconds": 46, "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 7. a string wait_seconds fails validation
-> {"action": "read", "token": "<token-2>", "wait_seconds": "1", "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 8. lead closes
-> {"action": "close", "summary": "Finished", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "closed": true
  }
}

== 9. a waiting read on a closed conversation returns at once
-> {"action": "read", "after": 1, "token": "<token-2>", "wait_seconds": 5, "workspace": "<workspace-1>"}
<- {
  "result": {
    "messages": [
      {
        "id": 2,
        "label": "Lead",
        "body": "Finished"
      }
    ],
    "more": false,
    "cursor": 2,
    "wake": true,
    "closed": true
  }
}

== 10. worker status shows usage from delivered pages
-> {"action": "status", "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "open": false,
    "members": {
      "Lead": {
        "role": "lead",
        "state": "replied",
        "idle_seconds": "<idle-seconds>",
        "messages": 2
      },
      "Worker": {
        "role": "worker",
        "state": "joined",
        "idle_seconds": "<idle-seconds>"
      }
    },
    "participant": "Worker"
  }
}

