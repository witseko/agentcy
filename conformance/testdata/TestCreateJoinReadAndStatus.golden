== 1. lead creates a conversation
-> {"action": "create", "brief": "Review the retry behavior", "initiator": "Lead", "invitees": ["Reviewer", "Analyst"], "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-1>",
    "token": "<token-1>",
    "invitations": {
      "Reviewer": "<code-1>",
      "Analyst": "<code-2>"
    },
    "join_prompt": "Review the retry behavior: Use agentcy to join with CODE. It returns the brief, roster, and initial messages (only call read_messages with wait_seconds=0 if 'more' is true). Say which role you joined as and start your part. Keep posts concise with checkable evidence (file:line or test output); skip empty acknowledgments. Send findings and questions directly to the peer who can act on them, report brief progress updates to the lead periodically while working, reply to your task ID with kind='done' or 'blocker', and check peer blockers before going idle. Follow the bridge's 'next' guidance. If your app lets you rename this session, set its title to \"Review the retry behavior\".",
    "role": "lead",
    "roster": {
      "Analyst": "worker",
      "Lead": "lead",
      "Reviewer": "worker"
    }
  }
}

== 2. reviewer joins
-> {"action": "join", "code": "<code-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-1>",
    "participant": "Reviewer",
    "role": "worker",
    "roster": {
      "Analyst": "worker",
      "Lead": "lead",
      "Reviewer": "worker"
    },
    "brief": "Review the retry behavior",
    "token": "<token-2>",
    "messages": [],
    "cursor": 0,
    "more": false
  }
}

== 3. the same code again names the taken slot
-> {"action": "join", "code": "<code-1>", "workspace": "<workspace-1>"}
<- {
  "error": "Invitation slot already taken: Reviewer"
}

== 4. lead posts
-> {"action": "post", "body": "Please check", "submission_id": "submission-1", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 1
  }
}

== 5. reviewer posts
-> {"action": "post", "body": "I checked", "submission_id": "submission-2", "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 2
  }
}

== 6. lead posts again
-> {"action": "post", "body": "Thanks", "submission_id": "submission-3", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 3
  }
}

== 7. reviewer reads from zero
-> {"action": "read", "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "messages": [
      {
        "id": 1,
        "label": "Lead",
        "body": "Please check"
      },
      {
        "id": 2,
        "label": "Reviewer",
        "body": "I checked"
      },
      {
        "id": 3,
        "label": "Lead",
        "body": "Thanks"
      }
    ],
    "more": false,
    "cursor": 3,
    "wake": true,
    "brief": "Review the retry behavior",
    "role": "worker",
    "roster": {
      "Analyst": "worker",
      "Lead": "lead",
      "Reviewer": "worker"
    }
  }
}

== 8. reviewer reads after the first message
-> {"action": "read", "after": 1, "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "messages": [
      {
        "id": 3,
        "label": "Lead",
        "body": "Thanks"
      }
    ],
    "more": false,
    "cursor": 3,
    "wake": true
  }
}

== 9. reviewer reads with a numeric-string cursor
-> {"action": "read", "after": "2", "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "messages": [
      {
        "id": 3,
        "label": "Lead",
        "body": "Thanks"
      }
    ],
    "more": false,
    "cursor": 3,
    "wake": true
  }
}

== 10. lead reads status
-> {"action": "status", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "open": true,
    "members": {
      "Lead": {
        "role": "lead",
        "state": "replied",
        "idle_seconds": "<idle-seconds>",
        "messages": 2
      },
      "Reviewer": {
        "role": "worker",
        "state": "replied",
        "idle_seconds": "<idle-seconds>",
        "messages": 1
      },
      "Analyst": {
        "role": "worker",
        "state": "invited"
      }
    },
    "participant": "Lead"
  }
}

