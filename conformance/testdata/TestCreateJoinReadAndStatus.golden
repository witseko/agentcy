== 12. analyst joins late and gets the initial page
-> {"action": "join", "code": "<code-2>", "model": "test/model", "token_budget": 5000, "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-1>",
    "participant": "Analyst",
    "role": "worker",
    "roster": {
      "Analyst": "worker",
      "Lead": "lead",
      "Reviewer": "worker"
    },
    "brief": "Review the retry behavior",
    "token": "<token-3>",
    "messages": [
      {
        "id": 1,
        "label": "Lead",
        "body": "Please check"
      },
      {
        "id": 2,
        "label": "Reviewer",
        "body": "I checked"
      },
      {
        "id": 3,
        "label": "Lead",
        "body": "Thanks"
      }
