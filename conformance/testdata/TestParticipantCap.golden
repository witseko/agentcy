== 1. lead creates with 16 invitees
-> {"action": "create", "brief": "Cap", "initiator": "Lead", "invitees": ["Worker 0", "Worker 1", "Worker 2", "Worker 3", "Worker 4", "Worker 5", "Worker 6", "Worker 7", "Worker 8", "Worker 9", "Worker 10", "Worker 11", "Worker 12", "Worker 13", "Worker 14", "Worker 15"], "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-1>",
    "token": "<token-1>",
    "invitations": {
      "Worker 0": "<code-1>",
      "Worker 1": "<code-2>",
      "Worker 2": "<code-3>",
      "Worker 3": "<code-4>",
      "Worker 4": "<code-5>",
