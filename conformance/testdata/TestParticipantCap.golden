== 2. an 18th slot is refused
-> {"action": "invite", "name": "Another", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "error": "Conversation already has 17 participants"
}

== 3. reissuing an existing slot still works
-> {"action": "invite", "name": "Worker 0", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "participant": "Worker 0",
    "role": "worker",
    "code": "<code-17>",
    "join_prompt": "Cap - worker (Worker 0): Use agentcy to join with CODE. It returns the brief, roster, and initial messages (only call read_messages with wait_seconds=0 if 'more' is true). Say which role you joined as and start your part. Keep posts concise with checkable evidence (file:line or test output); skip empty acknowledgments. Send findings and questions directly to the peer who can act on them, report brief progress updates to the lead periodically while working, reply to your task ID with kind='done' or 'blocker', and check peer blockers before going idle. Follow the bridge's 'next' guidance. If your app lets you rename this session, set its title to \"Cap - worker (Worker 0)\"."
  }
}

== 4. 17 invitees fail validation
-> {"action": "create", "brief": "Cap", "initiator": "Lead", "invitees": ["Worker 0", "Worker 1", "Worker 2", "Worker 3", "Worker 4", "Worker 5", "Worker 6", "Worker 7", "Worker 8", "Worker 9", "Worker 10", "Worker 11", "Worker 12", "Worker 13", "Worker 14", "Worker 15", "Worker 16"], "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 5. lead creates an open room
-> {"action": "create", "brief": "Open cap", "initiator": "Lead", "invitees": [], "open_invite": true, "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-2>",
    "token": "<token-2>",
    "invitations": {},
    "join_prompt": "Open cap: Use agentcy to join with CODE. It returns the brief, roster, and initial messages (only call read_messages with wait_seconds=0 if 'more' is true). Say which role you joined as and start your part. Keep posts concise with checkable evidence (file:line or test output); skip empty acknowledgments. Send findings and questions directly to the peer who can act on them, report brief progress updates to the lead periodically while working, reply to your task ID with kind='done' or 'blocker', and check peer blockers before going idle. Follow the bridge's 'next' guidance. If your app lets you rename this session, set its title to \"Open cap\".",
    "role": "lead",
    "roster": {
      "Lead": "lead"
    },
    "open_invite": {
      "code": "<code-18>",
      "join_prompt": "Open cap - worker: Use agentcy to join with CODE (pass your preferred name if you want one). It returns the brief, roster, and initial messages (only call read_messages with wait_seconds=0 if 'more' is true). Say which role you joined as and start your part. Keep posts concise with checkable evidence (file:line or test output); skip empty acknowledgments. Send findings and questions directly to the peer who can act on them, report brief progress updates to the lead periodically while working, reply to your task ID with kind='done' or 'blocker', and check peer blockers before going idle. Follow the bridge's 'next' guidance. If your app lets you rename this session, set its title to \"Open cap - worker\"."
    }
  }
}

