== 5. Alpha reports heavy usage
-> {"action": "report_usage", "input_tokens": 6000, "output_tokens": 1500, "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "participant": "Alpha",
    "usage": {
      "conversation_tokens": 7500,
      "input_tokens": 6000,
      "output_tokens": 1500,
      "model_tokens_used": 7500,
      "estimated_tokens": 2,
      "source": "reported",
      "actual_tokens": 7500,
      "model": "model-a",
      "initial_tokens": 10000,
      "remaining_tokens": 2500,
      "used_percent": 75.0,
      "remaining_percent": 25.0,
      "status": "warning"
    },
    "token_balance": {
      "balanced": false,
      "imbalance_gap_percent": 75.0,
      "overloaded": [
        "Alpha",
        "Lead"
      ],
      "preferred": [
        "Plain",
        "Bravo"
      ],
      "recommendation": "Token balance: Alpha is at 75.0% of budget (25.0% left) while Plain is at 0.0% (100.0% left). Prefer assigning new tasks or handoffs to Plain."
    }
  }
}

