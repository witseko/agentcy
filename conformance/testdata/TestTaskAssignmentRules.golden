== 1. lead creates
-> {"action": "create", "brief": "Review retries", "initiator": "Lead", "invitees": ["Alpha", "Bravo"], "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-1>",
    "token": "<token-1>",
    "invitations": {
      "Alpha": "<code-1>",
      "Bravo": "<code-2>"
    },
    "join_prompt": "Review retries: Use agentcy to join with CODE. It returns the brief, roster, and initial messages (only call read_messages with wait_seconds=0 if 'more' is true). Say which role you joined as and start your part. Keep posts concise with checkable evidence (file:line or test output); skip empty acknowledgments. Send findings and questions directly to the peer who can act on them, report brief progress updates to the lead periodically while working, reply to your task ID with kind='done' or 'blocker', and check peer blockers before going idle. Follow the bridge's 'next' guidance. If your app lets you rename this session, set its title to \"Review retries\".",
    "role": "lead",
    "roster": {
      "Alpha": "worker",
      "Bravo": "worker",
      "Lead": "lead"
    }
  }
}

== 2. Alpha joins
-> {"action": "join", "code": "<code-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-1>",
    "participant": "Alpha",
    "role": "worker",
    "roster": {
      "Alpha": "worker",
      "Bravo": "worker",
      "Lead": "lead"
    },
    "brief": "Review retries",
    "token": "<token-2>",
    "messages": [],
    "cursor": 0,
    "more": false
  }
}

== 3. Bravo joins
-> {"action": "join", "code": "<code-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "conversation": "<room-1>",
    "participant": "Bravo",
    "role": "worker",
    "roster": {
      "Alpha": "worker",
      "Bravo": "worker",
      "Lead": "lead"
    },
    "brief": "Review retries",
    "token": "<token-3>",
    "messages": [],
    "cursor": 0,
    "more": false
  }
}

== 4. a worker cannot assign a task
-> {"action": "post", "body": "Do this", "due_minutes": 10, "kind": "task", "submission_id": "submission-1", "to": "Bravo", "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "error": "Only a lead or co-lead can assign a task"
}

== 5. a task needs an addressee
-> {"action": "post", "body": "Do this", "due_minutes": 10, "kind": "task", "submission_id": "submission-2", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "error": "A task requires an addressee"
}

== 6. a task needs due_minutes
-> {"action": "post", "body": "Do this", "kind": "task", "submission_id": "submission-3", "to": "Alpha", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "error": "A task requires a timeline. Set due_minutes to the number of minutes you expect the task to take"
}

== 7. due_minutes on a note is refused
-> {"action": "post", "body": "FYI", "due_minutes": 10, "submission_id": "submission-4", "to": "Alpha", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "error": "Only a kind='task' message accepts due_minutes"
}

== 8. due_minutes of zero fails validation
-> {"action": "post", "body": "Do this", "due_minutes": 0, "kind": "task", "submission_id": "submission-5", "to": "Alpha", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 9. due_minutes above 1440 fails validation
-> {"action": "post", "body": "Do this", "due_minutes": 1441, "kind": "task", "submission_id": "submission-6", "to": "Alpha", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 10. string due_minutes fails validation
-> {"action": "post", "body": "Do this", "due_minutes": "30", "kind": "task", "submission_id": "submission-7", "to": "Alpha", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 11. an unknown kind fails validation
-> {"action": "post", "body": "Do this", "kind": "reassign", "submission_id": "submission-8", "to": "Alpha", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 12. a task to an unknown member
-> {"action": "post", "body": "Do this", "due_minutes": 10, "kind": "task", "submission_id": "submission-9", "to": "Ghost", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "error": "Unknown recipient 'Ghost' in this conversation. Active members: Alpha, Bravo, Lead"
}

== 13. lead assigns a task with the longest timeline
-> {"action": "post", "body": "Review retry limits", "due_minutes": 1440, "kind": "task", "submission_id": "limits", "to": "Alpha", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 1
  }
}

== 14. a retry keeps one task
-> {"action": "post", "body": "Review retry limits", "due_minutes": 1440, "kind": "task", "submission_id": "limits", "to": "Alpha", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 1
  }
}

== 15. a retry with a changed timeline is refused
-> {"action": "post", "body": "Review retry limits", "due_minutes": 40, "kind": "task", "submission_id": "limits", "to": "Alpha", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "error": "Submission ID already used for a different message"
}

== 16. lead can assign a task to itself
-> {"action": "post", "body": "Write the summary\n\n  with   details", "due_minutes": 1, "kind": "task", "submission_id": "submission-13", "to": "lead", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 2
  }
}

== 17. status shows open tasks with due times
-> {"action": "status", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "open": true,
    "members": {
      "Lead": {
        "role": "lead",
        "state": "replied",
        "idle_seconds": "<idle-seconds>",
        "messages": 2,
        "open_tasks": [
          {
            "id": 2,
            "due": "<now+1m>"
          }
        ]
      },
      "Alpha": {
        "role": "worker",
        "state": "joined",
        "open_tasks": [
          {
            "id": 1,
            "due": "<now+1440m>"
          }
        ]
      },
      "Bravo": {
        "role": "worker",
        "state": "joined"
      }
    },
    "participant": "Lead"
  }
}

