            "due": "<now+1m>"
          }
        ]
      },
      "Alpha": {
        "role": "worker",
        "state": "joined",
        "idle_seconds": "<idle-seconds>",
        "open_tasks": [
          {
            "id": 1,
            "due": "<now+1440m>"
          }
        ]
      },
      "Bravo": {
        "role": "worker",
        "state": "joined"
      }
    },
    "participant": "Alpha"
  }
}

