== 25. a cursor beyond the end
-> {"action": "read", "after": 1000, "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "messages": [],
    "more": false,
    "cursor": 1000,
    "wake": false
  }
}

== 26. a negative cursor fails validation
-> {"action": "read", "after": -1, "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 27. a cursor above the 63-bit limit fails validation
-> {"action": "read", "after": 9223372036854775808, "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 28. a fractional cursor fails validation
-> {"action": "read", "after": 1.5, "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "error": "Invalid bridge arguments"
}

== 29. a whole float cursor is accepted
-> {"action": "read", "after": 18.0, "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "messages": [
      {
        "id": 19,
        "label": "Lead",
