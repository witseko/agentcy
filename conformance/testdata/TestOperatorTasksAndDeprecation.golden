    "tasks": []
  }
}

== 6. a finished task
-> {"action": "post", "body": "Check the parser\nwith all fixtures", "due_minutes": 20, "kind": "task", "submission_id": "submission-1", "to": "Alpha", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 1
  }
}

== 7. a task to hand off
-> {"action": "post", "body": "   Review   the\tretry   limits   ", "due_minutes": 45, "kind": "task", "submission_id": "submission-2", "to": "Alpha", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 2
  }
}

== 8. a task to block
-> {"action": "post", "body": "<132 characters starting \"A task title\">", "due_minutes": 60, "kind": "task", "submission_id": "submission-3", "to": "Bravo", "token": "<token-1>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 3
  }
}

== 9. Alpha finishes the first task
-> {"action": "post", "body": "Parser checked", "kind": "done", "reply_to": 1, "submission_id": "submission-4", "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 4
  }
}

== 10. Alpha offers the second task
-> {"action": "post", "body": "Bravo, please take it", "kind": "handoff", "reply_to": 2, "submission_id": "submission-5", "to": "Bravo", "token": "<token-2>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 5
  }
}

== 11. Bravo comments on the offer
-> {"action": "post", "body": "Looking at it", "reply_to": 5, "submission_id": "submission-6", "token": "<token-3>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 6
  }
}

== 12. Bravo blocks the third task
-> {"action": "post", "body": "Need credentials", "kind": "blocker", "reply_to": 3, "submission_id": "submission-7", "token": "<token-3>", "workspace": "<workspace-1>"}
<- {
  "result": {
    "message_id": 7
  }
}

