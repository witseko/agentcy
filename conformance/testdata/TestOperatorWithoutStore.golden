== 1. list without a store
-> {"action": "operator_list", "directory": "<checkout>", "key": "<operator-key>", "version": 1}
<- {
  "result": {
    "conversations": []
  }
}

== 2. archived list without a store
-> {"action": "operator_list", "archived": true, "directory": "<checkout>", "key": "<operator-key>", "version": 1}
<- {
  "result": {
    "conversations": []
  }
}

== 3. search without a store
-> {"action": "operator_search", "directory": "<checkout>", "key": "<operator-key>", "query": "retry", "version": 1}
<- {
  "result": {
    "hits": []
  }
}

== 4. plugins without a configuration
